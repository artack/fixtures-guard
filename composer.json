{
    "name": "artack/fixtures-guard",
    "type": "symfony-bundle",
    "description": "Symfony bundle that stops Doctrine fixtures and Foundry from wiping a database whose data must stay",
    "keywords": ["symfony", "symfony-bundle", "doctrine", "fixtures", "foundry", "console", "database", "safety"],
    "homepage": "https://github.com/artack/fixtures-guard",
    "license": "MIT",
    "authors": [
        {
            "name": "ARTACK WebLab GmbH",
            "homepage": "https://www.artack.ch"
        }
    ],
    "require": {
        "php": ">=8.5",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/event-dispatcher": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.18 || ^3.0",
        "doctrine/doctrine-fixtures-bundle": "^4.1",
        "doctrine/orm": "^3.5",
        "phpunit/phpunit": "^13.2",
        "symfony/filesystem": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "zenstruck/foundry": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "Artack\\FixturesGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Artack\\FixturesGuard\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "update:tools": "composer update -d tools/php-cs-fixer && composer update -d tools/phpstan",
        "phpcs": "tools/php-cs-fixer/vendor/bin/php-cs-fixer fix -vvv --diff --dry-run --allow-risky=yes --ansi",
        "phpcs:fix": "tools/php-cs-fixer/vendor/bin/php-cs-fixer fix -vvv --allow-risky=yes --ansi",
        "phpstan": "tools/phpstan/vendor/bin/phpstan analyse -c phpstan.neon --ansi",
        "phpunit": "phpunit",
        "coverage": [
            "phpunit --coverage-clover build/coverage/clover.xml --coverage-text",
            "@php tests/coverage-check.php build/coverage/clover.xml"
        ],
        "test": [
            "@phpcs",
            "@phpstan",
            "@phpunit"
        ]
    }
}
